# ============================================================================
# RealtyCook Environment Configuration (Template)
# Copy this file to `.env` and fill in your live credentials.
#
# CRM data APIs still use the service role on the server.
# Auth (login / session cookies) also needs the public anon key for @supabase/ssr.
# NEVER put SUPABASE_SERVICE_ROLE_KEY in NEXT_PUBLIC_*.
# ============================================================================

# --- Supabase ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# Public (browser + SSR auth cookies) — same project URL + anon/publishable key
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key
NEXT_PUBLIC_SITE_URL=https://your-production-domain.com

# --- WhatsApp (backend reads REALTYCOOK_WHATSAPP_NUMBER) ---
REALTYCOOK_WHATSAPP_NUMBER=919056050813
WHATSAPP_NUMBER=919056050813
ADVISOR_NAME="Karan Yadav"
ADVISOR_DESIGNATION="SVP Sales"
